#!/bin/bash
# Pre-commit hook to prevent commits with wrong Git identity
# This hook enforces directory-based account separation

set -e

# Get current Git user email
CURRENT_EMAIL=$(git config user.email)
CURRENT_DIR=$(pwd)

# Define account rules
PERSONAL_EMAIL="webmaster@semek.org"
WORK_GITHUB_EMAIL="andre.semek@vattenfall.de"
WORK_DEVOPS_EMAIL="chn71@eur.corp.vattenfall.com"

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# Check if we're in a known directory
# NOTE: more specific rules must come before broader ones — e.g. work/_overview/
# is a private-identity subfolder nested inside the work/ (Azure DevOps) tree,
# so it must be checked before the generic */work/* rule below.
if [[ "$CURRENT_DIR" == *"/repos/personal/"* ]]; then
    EXPECTED_EMAIL="$PERSONAL_EMAIL"
    LOCATION="Personal GitHub"
elif [[ "$CURRENT_DIR" == *"/repos/work-github/"* ]] || [[ "$CURRENT_DIR" == *"/work/_overview"* ]] || [[ "$CURRENT_DIR" == *"/work/azure-rg-bookmarks"* ]]; then
    EXPECTED_EMAIL="$WORK_GITHUB_EMAIL"
    LOCATION="Vattenfall GitHub (erdkem)"
elif [[ "$CURRENT_DIR" == *"/repos/work-devops/"* ]] || [[ "$CURRENT_DIR" == *"/work/"* ]] || [[ "$CURRENT_DIR" == *"/_wt/"* ]]; then
    EXPECTED_EMAIL="$WORK_DEVOPS_EMAIL"
    LOCATION="Vattenfall Azure DevOps"
elif [[ "$CURRENT_DIR" == *"/projects/"* ]]; then
    EXPECTED_EMAIL="$PERSONAL_EMAIL"
    LOCATION="Personal projects (~/projects)"
else
    echo -e "${YELLOW}⚠️  WARNING: Repository outside managed directories!${NC}"
    echo -e "Current directory: ${CURRENT_DIR}"
    echo -e "Current email: ${CURRENT_EMAIL}"
    echo ""
    echo -e "Recommended directories:"
    echo -e "  ~/repos/personal/       (for ${PERSONAL_EMAIL})"
    echo -e "  ~/work/                 (for ${WORK_DEVOPS_EMAIL})"
    echo ""
    # Non-interactive mode (scripts, agents): allow if personal email is set
    if [[ ! -t 0 ]]; then
        if [[ "$CURRENT_EMAIL" == "$PERSONAL_EMAIL" ]]; then
            exit 0
        else
            echo -e "${RED}❌ Non-interactive commit blocked: set git user.email to ${PERSONAL_EMAIL}${NC}"
            exit 1
        fi
    fi
    read -p "Continue anyway? (y/N) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        exit 1
    fi
    exit 0
fi

# Verify email matches expected location
if [ "$CURRENT_EMAIL" != "$EXPECTED_EMAIL" ]; then
    echo -e "${RED}❌ COMMIT BLOCKED - WRONG ACCOUNT!${NC}"
    echo ""
    echo -e "Location: ${LOCATION}"
    echo -e "Expected: ${GREEN}${EXPECTED_EMAIL}${NC}"
    echo -e "Current:  ${RED}${CURRENT_EMAIL}${NC}"
    echo ""
    echo -e "To fix this, run:"
    echo -e "  ${YELLOW}git config user.email \"${EXPECTED_EMAIL}\"${NC}"
    echo ""
    exit 1
fi

# Success!
echo -e "${GREEN}✓${NC} Account verified: ${CURRENT_EMAIL} (${LOCATION})"

# Content-level private-identity leak check — separate from the author-field
# check above. Incident 2026-07-28: VAP-covis-ACAE committed a Cursor/
# SpecStory config file (.specstory/.project.json) containing
# "user_id": "webmaster@semek.org" as file CONTENT, with a correctly-set
# commit author. Author-field verification alone doesn't catch that class of
# leak — this scans the actual staged diff content in Vattenfall trees.
if [[ "$CURRENT_DIR" == *"/repos/work-devops/"* ]] || [[ "$CURRENT_DIR" == *"/work/"* ]] || [[ "$CURRENT_DIR" == *"/_wt/"* ]]; then
    LEAK_PATTERN="webmaster@semek\.org|@semek\.org"
    LEAKED_HITS=$(git diff --cached -U0 | grep -E '^\+' | grep -viE '^\+\+\+' | grep -EI "$LEAK_PATTERN" || true)
    if [[ -n "$LEAKED_HITS" ]]; then
        echo -e "${RED}❌ COMMIT BLOCKED - PRIVATE IDENTITY IN STAGED CONTENT!${NC}"
        echo ""
        echo -e "Found a reference to a private/non-Vattenfall identity in the staged diff:"
        echo "$LEAKED_HITS" | head -10
        echo ""
        echo -e "${YELLOW}This is a Vattenfall Azure DevOps tree — private identity strings must${NC}"
        echo -e "${YELLOW}never appear in committed content, even if the commit author is correct.${NC}"
        echo -e "Remove the offending file/content before committing (common source: AI"
        echo -e "coding-assistant session-scratch files like .specstory/.project.json —"
        echo -e "these should be caught by ~/.gitignore_global, check why they weren't)."
        echo ""
        exit 1
    fi
fi

exit 0
