# Copy this file to ~/.config/himalaya-web/ai.env and chmod 600 it.
# Keep the API key outside this repository and outside browser storage.
HIMALAYA_AI_PROVIDER=minimax
HIMALAYA_AI_BASE_URL=https://api.minimax.io/v1
HIMALAYA_AI_MODEL=MiniMax-M3
# HIMALAYA_AI_API_KEY=put-the-key-in-the-untracked-file
# Optional: 1000..120000 milliseconds, default 30000.
# HIMALAYA_AI_TIMEOUT_MS=30000
