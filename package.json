{
  "name": "hima",
  "version": "0.37.0",
  "description": "Fast, local-first browser email client powered by the Himalaya CLI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DnaMes/hima.git"
  },
  "author": "erdlabs <dev@erdlabs.com>",
  "keywords": [
    "email",
    "webmail",
    "himalaya",
    "mail-client",
    "local-first",
    "fastify",
    "react"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "build": "vite build && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.4",
    "@iarna/toml": "^2.2.5",
    "dompurify": "^3.3.0",
    "fastify": "^5.6.1",
    "mailparser": "^3.9.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tldts": "^7.4.16",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
